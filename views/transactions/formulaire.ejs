<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { titre: modeEdition ? 'Modifier' : 'Nouvelle transaction' }) %>
</head>
<body class="avec-nav-bas">
  <%- include('../partials/nav', { actif: 'transactions' }) %>

  <h1><%= modeEdition ? 'Modifier la transaction' : 'Nouvelle transaction' %></h1>

  <% if (erreurs.length > 0) { %>
    <div class="erreurs">
      <ul>
        <% erreurs.forEach(function(e) { %>
          <li><%= e %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= modeEdition ? '/transactions/' + id : '/transactions' %>">
    <label for="type">Type</label>
    <select id="type" name="type" required>
      <option value="DEPENSE" <%= transaction.type === 'DEPENSE' ? 'selected' : '' %>>Dépense</option>
      <option value="REVENU" <%= transaction.type === 'REVENU' ? 'selected' : '' %>>Revenu</option>
      <option value="EPARGNE" <%= transaction.type === 'EPARGNE' ? 'selected' : '' %>>Épargne</option>
    </select>

    <label for="categorie">Catégorie</label>
    <input type="text" id="categorie" name="categorie" list="categories-suggestions" value="<%= transaction.categorie %>" maxlength="50" required />
    <datalist id="categories-suggestions">
      <% categoriesSuggestions.forEach(function(c) { %>
        <option value="<%= c %>"></option>
      <% }) %>
    </datalist>

    <label for="montant">Montant (FCFA)</label>
    <input type="number" id="montant" name="montant" min="1" max="999999999" step="1" value="<%= transaction.montant %>" required />

    <label for="date">Date</label>
    <input type="date" id="date" name="date" value="<%= transaction.date %>" required />

    <label for="description">Description (optionnelle)</label>
    <input type="text" id="description" name="description" value="<%= transaction.description %>" maxlength="200" />

    <button type="submit"><%= modeEdition ? 'Enregistrer' : 'Ajouter' %></button>
  </form>

  <a class="lien" href="/categories">🏷️ Gérer mes catégories</a>
  <a class="lien" href="/transactions">&larr; Retour à la liste</a>
</body>
</html>
