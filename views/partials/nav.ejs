<header class="topbar">
  <div class="marque">
    <span class="logo">💰</span>
    <span class="marque-texte">Suivi&nbsp;Dépenses</span>
  </div>
  <div class="nav-droite">
    <%- include('theme-toggle') %>
    <a class="avatar" href="/parametres" title="Paramètres — <%= currentUser.nom %>"><%= currentUser.nom.charAt(0).toUpperCase() %></a>
    <form method="POST" action="/deconnexion">
      <button type="submit" class="btn-icone" title="Déconnexion" aria-label="Déconnexion">⏻</button>
    </form>
  </div>
</header>

<nav class="bottom-nav">
  <a href="/" class="<%= actif === 'accueil' ? 'actif' : '' %>" aria-label="Accueil" title="Accueil">
    <span class="bottom-nav-icone">🏠</span>
  </a>
  <a href="/transactions" class="<%= actif === 'transactions' ? 'actif' : '' %>" aria-label="Transactions" title="Transactions">
    <span class="bottom-nav-icone">💳</span>
  </a>
  <a href="/objectifs" class="<%= actif === 'objectifs' ? 'actif' : '' %>" aria-label="Objectifs" title="Objectifs">
    <span class="bottom-nav-icone">🎯</span>
  </a>
  <a href="/boutique" class="<%= actif === 'boutique' ? 'actif' : '' %>" aria-label="Équipe" title="Équipe">
    <span class="bottom-nav-icone">👥</span>
  </a>
</nav>
