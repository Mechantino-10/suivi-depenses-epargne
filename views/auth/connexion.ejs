<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { titre: 'Connexion' }) %>
</head>
<body class="page-auth">
  <div class="auth-toggle"><%- include('../partials/theme-toggle') %></div>

  <div class="auth-marque">
    <span class="logo-grand">💰</span>
    <p class="auth-sous-titre">Suivi de dépenses & épargne</p>
  </div>

  <div class="card auth-card">
    <h1>Se connecter</h1>

    <% if (erreur) { %>
      <div class="erreurs">⚠️ <%= erreur %></div>
    <% } %>

    <form method="POST" action="/connexion">
      <label for="telephone">Numéro de téléphone</label>
      <input type="tel" id="telephone" name="telephone" value="<%= telephone %>" maxlength="16" required />

      <label for="motDePasse">Mot de passe</label>
      <div class="champ-mot-de-passe">
        <input type="password" id="motDePasse" name="motDePasse" maxlength="72" required />
        <%- include('../partials/bouton-oeil', { cible: 'motDePasse' }) %>
      </div>

      <button type="submit">Se connecter</button>
    </form>

    <div class="separateur">ou</div>

    <a class="btn-google" href="/auth/google">
      <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.87 2.7-6.62z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.83.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.98v2.33A9 9 0 0 0 9 18z"/>
        <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.66 9c0-.59.1-1.17.29-1.7V4.97H.98A9 9 0 0 0 0 9c0 1.45.35 2.83.98 4.03l2.97-2.33z"/>
        <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .98 4.97l2.97 2.33C4.66 5.17 6.65 3.58 9 3.58z"/>
      </svg>
      Se connecter avec Google
    </a>
  </div>

  <a class="lien" href="/inscription">Pas encore de compte ? S'inscrire</a>
</body>
</html>
